---
import { getEntry } from 'astro:content';
import Tile from '../components/Tile.astro';
import '../styles/global.css';

const entry = await getEntry('landing', 'landing');
if (!entry) throw new Error('src/data/landing.yaml is missing');
const { title, subtitle, footer, tiles } = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Files in src/data that tiles can link to with a relative url ("./slides.pdf").
const dataFiles = import.meta.glob<string>(['../data/**/*', '!../data/**/*.yaml'], {
  query: '?url',
  import: 'default',
  eager: true,
});
const resolveUrl = (url: string) => {
  if (!url.startsWith('./')) return url;
  const file = dataFiles[`../data/${url.slice(2)}`];
  if (!file) throw new Error(`landing.yaml: file "${url}" not found in src/data/`);
  return file;
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {subtitle && <meta name="description" content={subtitle} />}
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <main>
      <header>
        <h1>{title}</h1>
        {subtitle && <p class="subtitle">{subtitle}</p>}
      </header>
      <nav class="grid" aria-label="Links">
        {tiles.map((item) =>
          item.kind === 'section' ? <h2 class="section">{item.section}</h2> : <Tile {...item} url={resolveUrl(item.url)} />
        )}
      </nav>
      {footer && <footer>{footer}</footer>}
    </main>
  </body>
</html>
