---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

interface Props {
  title: string;
  description: string;
  url: string;
  icon?: string;
  image?: ImageMetadata;
  highlight?: boolean;
}

const { title, description, url, icon, image, highlight } = Astro.props;
---

<a class:list={['tile', { highlight }]} href={url} target="_blank" rel="noopener noreferrer">
  <span class="media" aria-hidden="true">
    {icon ? <Icon name={icon} /> : image && <Image src={image} alt="" width={104} height={104} />}
  </span>
  <span class="text">
    <span class="title">{title}</span>
    <span class="description">{description}</span>
  </span>
  <span class="arrow" aria-hidden="true"><Icon name="lucide:arrow-up-right" /></span>
</a>
